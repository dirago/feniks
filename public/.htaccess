# Apache configuration — OVH shared hosting (copied to dist/ by Vite).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

# ---------------------------------------------------------------------------
# Redirects: HTTP → HTTPS and feniks.fr → www.feniks.fr (canonical URL).
# Requires an active SSL certificate for both hosts (OVH Multisite → SSL).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^feniks\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.feniks.fr/$1 [R=301,L]

  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/pdf .pdf
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript text/javascript application/json application/xml \
    image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Default: short cache for files whose name never changes (CV, OG image, icons).
  Header set Cache-Control "public, max-age=3600"

  # Vite assets carry a content hash in their name: cache forever.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # The HTML entry point must always be revalidated to pick up new assets.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # Security headers
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Enable once HTTPS is confirmed working on both hosts:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Never serve the deploy state file written by the GitHub Action.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
